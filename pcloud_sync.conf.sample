# =============================================================================
# pCloud Sync Configuration
# Copy this file to pcloud_sync.conf and edit with your settings
# =============================================================================

# --- PATHS ---
# Source root directory (local)
SOURCE_ROOT="/media/4tb"

# Destination root (rclone remote)
DEST_ROOT="pcloud_encrypted:media/greenflame"

# Archive root (where deleted/modified files are moved if not using -d)
# Must NOT be inside DEST_ROOT to prevent overlapping sync errors
ARCHIVE_ROOT="pcloud_encrypted:media/greenflame_archive"

# Default subfolder to sync (can be overridden via command line)
# Leave empty to sync entire SOURCE_ROOT
SUBFOLDER=""

# --- LOG & STATE FILES ---
DIFF_LOG="/opt/backup/diff.log"
STATUS_FILE="/opt/backup/last_sync_status"
HISTORY_FILE="/opt/backup/history.csv"
LOCKFILE="/var/run/pcloud_sync.lock"

# --- NOTIFICATIONS ---
# Leave empty to disable email notifications
EMAIL_RECIPIENT="you@example.com"

# --- SYNC SETTINGS ---
# Number of parallel transfers (keep low for limited upload bandwidth)
TRANSFERS=1

# Safety limit: abort if more than this many files would be deleted
MAX_DELETES=100

# Number of random files to verify when using -v flag
VERIFY_SAMPLE_COUNT=5

# --- BANDWIDTH SCHEDULING (used with -b flag) ---
# Daytime throttle (09:00-23:00)
BW_DAYTIME="2M"

# Nighttime limit (23:00-09:00), 0 = unlimited
BW_NIGHTTIME="0"
